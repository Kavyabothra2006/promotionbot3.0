# Telegram
BOT_TOKEN=replace_with_real_bot_token
SUPER_ADMIN_IDS=123456789

# PostgreSQL (async SQLAlchemy URL)
# Railway may expose DATABASE_URL as postgres:// or postgresql://; the app normalizes it.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Redis
REDIS_URL=redis://:PASSWORD@HOST:6379/0

# Bot behaviour
THROTTLE_RATE_LIMIT=0.7
DEFAULT_REFERRAL_TARGET=2
INVITE_EXPIRY_HOURS=48
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
PROCESSED_UPDATE_RETENTION_DAYS=14
IDEMPOTENCY_LOCK_SECONDS=3600

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=production
