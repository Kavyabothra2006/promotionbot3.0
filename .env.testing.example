# Copy this file to .env for a staging/test bot.
# NEVER use a production BOT_TOKEN here.

# Telegram
BOT_TOKEN=PASTE_TEST_BOT_TOKEN_HERE
SUPER_ADMIN_IDS=123456789

# PostgreSQL - dedicated TEST/STAGING database only
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/telegram_bot_test

# Redis - dedicated TEST/STAGING instance or isolated database number
REDIS_URL=redis://:PASSWORD@HOST:6379/5

# Safer test defaults
THROTTLE_RATE_LIMIT=0.7
DEFAULT_REFERRAL_TARGET=2
INVITE_EXPIRY_HOURS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=900
PROCESSED_UPDATE_RETENTION_DAYS=7
IDEMPOTENCY_LOCK_SECONDS=3600

# Logging
LOG_LEVEL=DEBUG
ENVIRONMENT=testing
